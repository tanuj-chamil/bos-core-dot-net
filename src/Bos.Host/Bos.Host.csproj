<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <AssemblyName>bos</AssemblyName>
    <Product>BOS Core</Product>
    <Description>BOS Core HTTP host and operator tools</Description>
    <RuntimeIdentifiers>linux-x64;win-x64</RuntimeIdentifiers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Bos.Application/Bos.Application.csproj" />
    <ProjectReference Include="../Bos.Sqlite/Bos.Sqlite.csproj" />
    <ProjectReference Include="../Bos.Identity/Bos.Identity.csproj" />
    <ProjectReference Include="../Bos.Flows/Bos.Flows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../../docs/examples/*" Link="samples/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../docs/api-usage.md" Link="API-USAGE.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="../../docs/dependencies.md" Link="NOTICES.md" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Remove="packages.lock.json" />
    <Content Remove="packages.*.publish.lock.json" />
    <Content Include="packages.lock.json" Link="dependencies.lock.json" TargetPath="dependencies.lock.json" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <Content Include="packages.$(RuntimeIdentifier).publish.lock.json" Condition="'$(RuntimeIdentifier)' != '' and '$(PublishSingleFile)' == 'true'" Link="dependencies.publish.lock.json" TargetPath="dependencies.publish.lock.json" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>
</Project>
